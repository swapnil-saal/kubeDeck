{
  "name": "kubedeck",
  "version": "1.11.0",
  "description": "KubeDeck — A native macOS Kubernetes navigator. Browse clusters, namespaces, and resources with a built-in terminal.",
  "author": "Swapnil Saal <swapnil-saal>",
  "homepage": "https://github.com/swapnil-saal/kube-navigator",
  "repository": {
    "type": "git",
    "url": "https://github.com/swapnil-saal/kube-navigator.git"
  },
  "type": "module",
  "license": "MIT",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "electron:dev": "electron .",
    "package": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && electron-builder --mac --publish never",
    "package:dir": "CSC_IDENTITY_AUTO_DISCOVERY=false npm run build && electron-builder --mac --dir --publish never",
    "package:win": "npm run build && electron-builder --win --publish never",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/openai": "^4.0.83",
    "@ai-sdk/openai-compatible": "^3.0.62",
    "@assistant-ui/react": "^0.15.23",
    "@assistant-ui/react-ai-sdk": "^1.4.14",
    "@assistant-ui/react-markdown": "^0.14.18",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.60.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.127",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "express": "^5.0.1",
    "framer-motion": "^11.13.1",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.1.16",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "^5.0.0",
    "@types/node": "20.19.27",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  }
}
